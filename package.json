{
  "name": "research-to-article-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Turns verified research notes into scheduled WordPress articles with an LLM, behind two quality gates.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
