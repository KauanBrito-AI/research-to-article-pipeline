# Copy to .env and fill in. .env is ignored by git: never commit real keys.

# Model
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ARTICLE_LANGUAGE=English

# Featured image job API (optional; posts go out without an image if empty)
IMAGE_API_KEY=

# WordPress: an application password, not your login password
WP_URL=https://example.com
WP_USER=
WP_APP_PASSWORD=

# Link used in the last paragraph of every article
DIRECTORY_URL=https://example.com/tools/

# Schedule: weekdays (0 = Sunday … 6 = Saturday) and local time
PUBLISH_DAYS=2,5
PUBLISH_TIME=09:00

# Optional: price per million tokens, to print the cost of each run
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
